# Environment: Production
# Backend: Firebase Realtime Database (REST API) - project triaid-solidevs
VITE_TRIAGE_PLATFORM_API_URL="https://triaid-solidevs-default-rtdb.firebaseio.com"

# Triage Classification bounded context
VITE_CLASSIFICATIONS_ENDPOINT_PATH="/triage-classifications"

# Specialty Assignment bounded context
VITE_REFERRALS_ENDPOINT_PATH="/referrals"
VITE_SPECIALTIES_ENDPOINT_PATH="/specialties"
VITE_VOUCHERS_ENDPOINT_PATH="/vouchers"
# Patient Registration bounded context
VITE_PATIENTS_ENDPOINT_PATH="/patients"
VITE_EPISODES_ENDPOINT_PATH="/episodes"
VITE_DEVICES_ENDPOINT_PATH="/devices"
VITE_SYMPTOMS_ENDPOINT_PATH="/symptoms"

# Alerting bounded context
VITE_ALERTS_ENDPOINT_PATH="/alerts"
