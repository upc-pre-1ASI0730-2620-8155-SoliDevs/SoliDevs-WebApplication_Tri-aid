# Environment: Production
# Backend: TriAid Platform REST API deployed on Render
VITE_TRIAGE_PLATFORM_API_URL="https://triaid-api.onrender.com/api/v1"

# Triage Classification bounded context
VITE_CLASSIFICATIONS_ENDPOINT_PATH="/triage-classifications"

# Specialty Assignment bounded context
VITE_REFERRALS_ENDPOINT_PATH="/specialty-assignment/referrals"
VITE_SPECIALTIES_ENDPOINT_PATH="/specialty-assignment/specialties"
VITE_VOUCHERS_ENDPOINT_PATH="/vouchers"
# Patient Registration bounded context
VITE_PATIENTS_ENDPOINT_PATH="/patients"
VITE_EPISODES_ENDPOINT_PATH="/episodes"
VITE_DEVICES_ENDPOINT_PATH="/devices"
VITE_SYMPTOMS_ENDPOINT_PATH="/symptoms"

# Alerting bounded context
VITE_ALERTS_ENDPOINT_PATH="/alerts"

# Subscription bounded context
VITE_PLANS_ENDPOINT_PATH="/plans"
VITE_SUBSCRIPTIONS_ENDPOINT_PATH="/subscriptions"

# IAM bounded context
VITE_USERS_ENDPOINT_PATH="/users"
VITE_SESSIONS_ENDPOINT_PATH="/sessions"
